const { HarmonyPatch, HarmonyPostfix } = require('melonjs');
const { PlayViewController, PopupManager, PopupController } = require('il2cpp');
const { TextMeshProUGUI, Image, Color } = require('unity');

let shown = false;

HarmonyPatch(PlayViewController, 'Start', () => {
  HarmonyPostfix(async () => {
    if (shown) return;
    shown = true;

    try {
      const popup = PopupManager.Instance.OpenPopup('InfoPopup', 0);
      if (!popup) return;

      // 🔹 TÍTULO DE CIMA (antes era Language)
      const tituloPrincipal = popup.transform.Find('Title');
      if (tituloPrincipal) {
        const txtTitulo = tituloPrincipal.GetComponent(TextMeshProUGUI);
        if (txtTitulo) {
          txtTitulo.text = 'Stumble sla';
          txtTitulo.fontSize = 34;
          txtTitulo.color = Color.white;
        }
      }

      // DESCRIÇÃO
      const desc = popup.transform.Find('TextBG/Description');
      if (desc) {
        const txt = desc.GetComponent(TextMeshProUGUI);
        if (txt) {
          txt.text = 
`Welcome to Stumble sla! This is a special mod of
Stumble Guys version 0.56 created by <color=yellow>@ibp</color>,
designed to bring you extra fun, chaos, and excitement

Thanks to <color=yellow>IBP?</color> who helped me get the project :)
Enjoy every stumble and have an amazing time!`;
          txt.fontSize = 20;
          txt.alignment = TextAlignmentOptions.Center;
        }
      }

      // BOTÃO
      const button = popup.transform.Find('Button');
      if (button) {
        const txtBtn = button.GetComponentInChildren(TextMeshProUGUI);
        if (txtBtn) txtBtn.text = "let's play!";

        const imgBtn = button.GetComponent(Image);
        if (imgBtn) imgBtn.color = Color.white;
      }

    } catch (ex) {
      console.error(ex);
    }
  });
});
