const express = require('express');
const app = express();
const PORTA = 3000;

// Status do popup
let popupAtivo = true;

// Rota para o jogo consultar
app.get('/status-popup', (req, res) => {
  res.json({
    ativo: popupAtivo,
    titulo: "Stumble sla",
    descricao: "Welcome to Stumble sla! This is a special mod of\nStumble Guys version 0.56 created by <color=yellow>@ibp</color>,\ndesigned to bring you extra fun, chaos, and excitement\n\nThanks to <color=yellow>IBP?</color> who helped me get the project :)\nEnjoy every stumble and have an amazing time!",
    textoBotao: "let's play!",
    corBotao: "white"
  });
});

// Rota para ligar/desligar o popup
app.get('/popup/ligar', (req, res) => {
  popupAtivo = true;
  res.send("✅ Popup ATIVADO");
});

app.get('/popup/desligar', (req, res) => {
  popupAtivo = false;
  res.send("❌ Popup DESATIVADO");
});

app.listen(PORTA, () => {
  console.log(`✅ Backend rodando na porta ${PORTA}`);
  console.log(`🔗 Consultar: http://localhost:${PORTA}/status-popup`);
});
